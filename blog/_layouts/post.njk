---
layout: base.njk
---

<article class="post">
    <header class="post-header">
        <h1>{{ title }}</h1>
        <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
        {% if tags %}
        <div class="tags">
            {% for tag in tags %}
                {% if tag != "posts" %}
                <span class="tag">{{ tag }}</span>
                {% endif %}
            {% endfor %}
        </div>
        {% endif %}
    </header>
    
    <div class="post-content">
        {{ content | safe }}
    </div>
    
    <footer class="post-footer">
        <a href="/blog/">&larr; Back to all posts</a>
    </footer>
</article>
